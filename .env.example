# ===== BOT（VPS）でも Web（Vercel）でも使う =====
# サーバーID
GUILD_ID=
# Supabase の接続URL（空なら手元の demen.db を使う）
DATABASE_URL=

# ===== BOT だけ =====
# Discord Developer Portal の Bot トークン
DISCORD_TOKEN=ここにトークン

# ===== Web だけ（Vercel の Environment Variables に入れる）=====
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 公開URL（例 https://guerrilla-demen-bot.vercel.app）
BASE_URL=http://localhost:8000
# 長いランダム文字列（python -c "import secrets;print(secrets.token_hex(32))" で作れる）
SESSION_SECRET=
